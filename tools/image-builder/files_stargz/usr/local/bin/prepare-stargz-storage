#!/bin/sh
# Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
# SPDX-License-Identifier: Apache-2.0
# Use the underlying guest-upper filesystem, not the overlaid guest root.
set -eu
backing=/rom/overlay
source_dir=$backing/stargz
store=/var/lib/containerd-stargz-grpc

fail() {
    echo "stargz storage: $*" >&2
    exit 1
}

mountpoint -q "$backing" || fail "guest upper is not mounted at $backing"
case "$(stat -f -c %t "$backing")" in
    ef53) ;; # Runtime-provisioned ext4 guest-upper disk.
    1021994)
        # RAM is an explicit baseline/legacy layout, never a fallback for disk.
        case " $(cat /proc/cmdline) " in
            *" overlay_root=ram "*) ;;
            *) fail "RAM guest upper requires explicit overlay_root=ram" ;;
        esac
        ;;
    *) fail "unsupported guest-upper filesystem" ;;
esac

mkdir -p "$source_dir" "$store"
if mountpoint -q "$store"; then
    [ "$(stat -c %d:%i "$source_dir")" = "$(stat -c %d:%i "$store")" ] ||
        fail "existing store mount does not reference the private guest upper"
else
    mount --bind "$source_dir" "$store"
fi
