# Options to env precede assignments. Example root/default race invocation:
sudo -n env -u GOMAXPROCS TMPDIR="$TMPDIR" "$PWD/bin/task-wait-sync-race.test" \
  -test.v -test.failfast -test.run='^TestTaskManager_CreateExecDeleteTask$' \
  -test.count=25 -test.timeout=90s
